[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_jitter_fix=0.0
common/physics_interpolation=true

[shader_globals]

psx_retro={
"type": "float",
"value": 1.0
}
psx_snap_lines={
"type": "float",
"value": 162.0
}
psx_levels={
"type": "float",
"value": 48.0
}
psx_pixel_lines={
"type": "float",
"value": 0.0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.03, 0.015, 0.06, 1)
lights_and_shadows/positional_shadow/atlas_size=1024
limits/opengl/max_lights_per_object=8
