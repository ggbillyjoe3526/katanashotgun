# Editor settings the project is written with. GDScript uses tabs (Godot's style guide).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,gdshader,tscn,tres,cfg,godot}]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,py,sh,mjs}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
