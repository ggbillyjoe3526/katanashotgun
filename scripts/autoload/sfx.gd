extends Node
## Sound playback and the music director (spec §10).
##
## Sound effects are cues: one data file per sound in res://assets/audio/cues/
## (SfxCue), loaded at start. Sfx.play("shotgun") plays shotgun.tres. Voices
## come from fixed pools (VoicePool) with per-cue voice limits and priorities,
## so a horde never cuts off the player's own weapons.
##
## Music is tracks: one data file per piece in res://assets/music/tracks/
## (MusicTrack). The director builds a seeded shuffle of the combat tracks
## with crossfades, a theme per boss and a title theme from them, and fades
## stem layers in and out with the fight's intensity. The placeholder music is
## generated by tools/gen_music.py; assets/audio/README.md explains how to
## drop in professional audio.
##
## Mix (spec §10.1): every sound goes through a bus from default_bus_layout.tres
## (Master, Music, SFX, Ambience, UI). The mix levels live on those buses; the
## Settings menu adds the player's sliders on top. Music ducking lives on the
## music players, never on a bus's volume.

const CUE_DIR := "res://assets/audio/cues/"
const SOUND_DIR := "res://assets/audio/"
const TRACK_DIR := "res://assets/music/tracks/"
const BUS_MUSIC := &"Music"
const BUS_SFX := &"SFX"
const BUS_AMBIENCE := &"Ambience"
const BUS_UI := &"UI"
const VOICES_2D := 20
const VOICES_3D := 20
const POSITIONAL_THROTTLE_EXTRA_MS := 15 # positional repeats are spaced a little more
## Big hits duck the music (spec §10.1). Only loud plays count, and the duck
## can't retrigger straight away, so a horde never keeps the music pinned down.
const IMPACT_MIN_VOL_DB := -3.0 # quieter plays of a ducking cue don't duck
const IMPACT_COOLDOWN := 1.5 # real seconds before the duck can retrigger
const IMPACT_RECOVER_DB := 6.0 # dB per real second the music climbs back
## Rain (spec §10.3): two looping layers, far back and ducked under the music
## by the Ambience bus. Each slowly swells and fades so it comes and goes.
const RAIN_DB := [-80.0, -2.0, -3.0] # light layer at none / light / heavy
const RAIN_HEAVY_DB := [-80.0, -80.0, -3.0] # heavy layer
const RAIN_SWELL_DB := 6.0 # how far a layer drifts below its level
const RAIN_SWELL_EVERY := Vector2(5.0, 12.0) # seconds between new swell depths
const RAIN_SWELL_SPEED := 1.2 # dB per second while drifting
const RAIN_FADE_SPEED := 20.0 # dB per second when rain starts or stops
const MUSIC_DB := -6.0
const FADE := 2.5
## Music intensity (0 to 1) drives the stem layers: combo heat, then boss
## enrage pins it high.
const COMBO_FOR_FULL_INTENSITY := 25.0
const ENRAGED_INTENSITY := 1.0
const INTENSITY_RISE := 0.8 # per real second
const INTENSITY_FALL := 0.15 # per real second, so layers linger after a burst

var cues := {} # StringName -> SfxCue
var tracks := {} # id -> MusicTrack
var combat_tracks: Array[String] = [] # ids, sorted so the seeded shuffle is stable
var boss_tracks := {} # boss kind -> id
var title_track := ""
var pool_2d: VoicePool
var pool_3d: VoicePool
var _last := {}
var _missing := {} # names with no cue and no file, so a miss costs one lookup
var _key3d := {} # name -> throttle key for positional plays, built once
var rain: AudioStreamPlayer
var rain_heavy: AudioStreamPlayer
var _rain_level := 0
var _swell := [0.0, 0.0] # current dB below the level, per rain layer
var _swell_target := [0.0, 0.0]
var _swell_t := [0.0, 0.0]
var _impact := 0.0 # dB the music is pulled down after a big hit
var _impact_ready_at := 0.0 # _clock time the duck may retrigger
var _clock := 0.0 # real seconds since start (throttling; never the wall clock)
## Presentation-only randomness (pitch, variants, rain swells): its own
## stream so it can never shift a seeded run.
var _rng := RandomNumberGenerator.new()

var _mus: Array[AudioStreamPlayer] = []
var _mus_track: Array[MusicTrack] = [null, null]
var _active := 0
var _mode := "none" # none | title | combat | boss
var _playlist: Array = []
var _pl_i := 0
var _duck := 0.0
var _fading := false
var _cut := false # music cut to silence (boss felled, player death)
var intensity := 0.0 # current music intensity, 0 to 1
var _enraged := false


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_load_cues()
	_load_tracks()
	var voices: Array = []
	for i in VOICES_2D:
		var p := AudioStreamPlayer.new()
		add_child(p)
		voices.append(p)
	pool_2d = VoicePool.new(voices)
	var voices3d: Array = []
	for i in VOICES_3D:
		var p3 := AudioStreamPlayer3D.new()
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		add_child(p3)
		voices3d.append(p3)
	pool_3d = VoicePool.new(voices3d)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.volume_db = -80.0
		m.bus = BUS_MUSIC
		add_child(m)
		_mus.append(m)
	rain = _make_bed("res://assets/audio/rain.ogg")
	rain_heavy = _make_bed("res://assets/audio/rain_heavy.ogg")
	_rng.randomize()
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--record-mix"):
			add_child(preload("res://scripts/debug_mix_record.gd").new())


func _load_cues() -> void:
	for f in ResourceLoader.list_directory(CUE_DIR):
		if f.get_extension() == "tres":
			var c := load(CUE_DIR + f) as SfxCue
			if c and not c.streams.is_empty():
				cues[StringName(f.get_basename())] = c
			else:
				push_warning("audio cue %s has no sound" % f)


func _load_tracks() -> void:
	for f in ResourceLoader.list_directory(TRACK_DIR):
		if f.get_extension() != "tres":
			continue
		var t := load(TRACK_DIR + f) as MusicTrack
		if t == null or t.stems.is_empty():
			push_warning("music track %s has no stems" % f)
			continue
		var id := f.get_basename()
		tracks[id] = t
		match t.role:
			"combat":
				combat_tracks.append(id)
			"boss":
				boss_tracks[t.boss_kind] = id
			"title":
				title_track = id
	combat_tracks.sort()


## The cue for a sound, or null. A sound that was added as a file but has no
## cue yet still plays, with SfxCue's defaults (tools/make_audio_data.gd
## writes its cue file).
func cue(name: StringName) -> SfxCue:
	var c: SfxCue = cues.get(name)
	if c == null and not _missing.has(name):
		for ext in ["wav", "ogg"]:
			var path := "%s%s.%s" % [SOUND_DIR, name, ext]
			if ResourceLoader.exists(path):
				c = SfxCue.new()
				c.streams = [load(path)]
				cues[name] = c
				break
		if c == null:
			_missing[name] = true
	return c


func _make_bed(path: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	var st: AudioStreamOggVorbis = load(path)
	st.loop = true
	p.stream = st
	p.volume_db = -80.0
	p.bus = BUS_AMBIENCE
	add_child(p)
	return p


func bus_for(name: String) -> StringName:
	var c := cue(name)
	return StringName(c.bus) if c else BUS_SFX


func _throttled(name: StringName, ms: int) -> bool:
	var now := _clock * 1000.0
	if _last.get(name, -100000.0) > now - ms:
		return true
	_last[name] = now
	return false


func _on_played(c: SfxCue, vol_db: float) -> void:
	if c.music_duck_db < 0.0 and vol_db >= IMPACT_MIN_VOL_DB and _clock >= _impact_ready_at:
		_impact = minf(_impact, c.music_duck_db)
		_impact_ready_at = _clock + IMPACT_COOLDOWN


## Plays a sound everywhere (not positional). vol_db and pitch come from the
## caller; the cue adds its own trim and decides the bus.
func play(name: StringName, vol_db := 0.0, pitch := 1.0, pitch_var := 0.06) -> void:
	var c := cue(name)
	if c == null or _throttled(name, c.throttle_ms):
		return
	var i := pool_2d.acquire(name, c.priority, c.max_voices, _clock)
	if i < 0:
		return
	var p: AudioStreamPlayer = pool_2d.players[i]
	p.stream = c.pick(_rng)
	p.bus = StringName(c.bus)
	p.volume_db = vol_db + c.volume_db
	p.pitch_scale = _pitch(c, pitch, pitch_var)
	p.play()
	_on_played(c, vol_db)


## Plays a sound at a point in the world.
func play_at(name: StringName, pos: Vector3, vol_db := 0.0, pitch := 1.0, pitch_var := 0.08) -> void:
	var c := cue(name)
	if c == null:
		return
	if not _key3d.has(name):
		_key3d[name] = StringName(name + "@3d")
	if _throttled(_key3d[name], c.throttle_ms + POSITIONAL_THROTTLE_EXTRA_MS):
		return
	var i := pool_3d.acquire(name, c.priority, c.max_voices, _clock)
	if i < 0:
		return
	var p: AudioStreamPlayer3D = pool_3d.players[i]
	p.stream = c.pick(_rng)
	p.global_position = pos
	p.unit_size = c.unit_size
	p.max_distance = c.max_distance
	p.bus = StringName(c.bus)
	p.volume_db = vol_db + c.volume_db
	p.pitch_scale = _pitch(c, pitch, pitch_var)
	p.play()
	_on_played(c, vol_db)


func _pitch(c: SfxCue, pitch: float, pitch_var: float) -> float:
	if not c.vary_pitch or pitch_var <= 0.0:
		return pitch
	return pitch * _rng.randf_range(1.0 - pitch_var, 1.0 + pitch_var)


# ---------------------------------------------------------------- weather
## 0 = dry, 1 = light rain, 2 = heavy rain (adds the heavy layer).
func set_rain(level: int) -> void:
	_rain_level = clampi(level, 0, 2)
	if RAIN_DB[_rain_level] > -79.0 and not rain.playing:
		rain.play(_rng.randf() * rain.stream.get_length())
	if RAIN_HEAVY_DB[_rain_level] > -79.0 and not rain_heavy.playing:
		rain_heavy.play(_rng.randf() * rain_heavy.stream.get_length())


func _update_bed(p: AudioStreamPlayer, layer: int, level_db: float, dt: float) -> void:
	# drift towards a new swell depth every few seconds so the rain ebbs
	_swell_t[layer] -= dt
	if _swell_t[layer] <= 0.0:
		_swell_t[layer] = _rng.randf_range(RAIN_SWELL_EVERY.x, RAIN_SWELL_EVERY.y)
		_swell_target[layer] = -_rng.randf() * RAIN_SWELL_DB
	_swell[layer] = move_toward(_swell[layer], _swell_target[layer], RAIN_SWELL_SPEED * dt)
	var want: float = level_db + _swell[layer] if level_db > -79.0 else -80.0
	p.volume_db = move_toward(p.volume_db, want, RAIN_FADE_SPEED * dt)
	if want <= -79.0 and p.volume_db <= -79.0 and p.playing:
		p.stop()


# ---------------------------------------------------------------- music
func _crossfade_to(id: String) -> void:
	var t: MusicTrack = tracks.get(id)
	if t == null:
		return
	_cut = false
	var next := 1 - _active
	var p := _mus[next]
	p.stream = t.build()
	t.set_intensity(intensity)
	_mus_track[next] = t
	p.volume_db = -40.0
	p.play()
	_active = next
	_fading = true


func play_title_music() -> void:
	if _mode == "title":
		return
	_mode = "title"
	_enraged = false
	_crossfade_to(title_track)


## Starts the combat playlist in an order taken from the run seed.
func start_combat_music(seed_v: int) -> void:
	var r := RandomNumberGenerator.new()
	r.seed = seed_v
	_playlist = combat_tracks.duplicate()
	if _playlist.is_empty():
		return
	for i in range(_playlist.size() - 1, 0, -1):
		var j := r.randi_range(0, i)
		var tmp = _playlist[i]
		_playlist[i] = _playlist[j]
		_playlist[j] = tmp
	_pl_i = 0
	_mode = "combat"
	_enraged = false
	_crossfade_to(_playlist[0])


func _next_combat_track() -> void:
	if _playlist.is_empty():
		return
	_pl_i = (_pl_i + 1) % _playlist.size()
	_crossfade_to(_playlist[_pl_i])


func play_boss_music(kind: String) -> void:
	_mode = "boss"
	_enraged = false
	_crossfade_to(boss_tracks.get(kind, boss_tracks.values()[0] if not boss_tracks.is_empty() else ""))


## A boss dropped below half health: the music goes all in.
func on_boss_enraged() -> void:
	_enraged = true


func end_boss_music() -> void:
	_enraged = false
	if _mode != "boss":
		return
	_mode = "combat"
	_next_combat_track()


## Cuts the music to silence fast (the hush after a boss dies, or you do).
func music_cut() -> void:
	_cut = true
	_enraged = false
	_mode = "none"


## Brings the combat playlist back after a cut, on the next track.
func resume_combat() -> void:
	_mode = "combat"
	_next_combat_track()


func duck_music(db: float) -> void:
	# kept for callers: 0 = full, negative = quieter
	_duck = clampf(db - MUSIC_DB, -60.0, 0.0)


func _process(_delta: float) -> void:
	# presentation runs on real time, so slow-mo and hitstop never drag a fade
	var delta := Game.real_dt
	_clock += delta
	_update_bed(rain, 0, RAIN_DB[_rain_level], delta)
	_update_bed(rain_heavy, 1, RAIN_HEAVY_DB[_rain_level], delta)
	_impact = move_toward(_impact, 0.0, IMPACT_RECOVER_DB * delta)
	_update_intensity(delta)
	var target := MUSIC_DB + _duck + _impact
	for i in _mus.size():
		var p := _mus[i]
		if not p.playing:
			continue
		var trim := _mus_track[i].volume_db if _mus_track[i] else 0.0
		var want := target + trim if (i == _active and not _cut) else -80.0
		var speed := 40.0 / FADE if not _cut else 90.0
		p.volume_db = move_toward(p.volume_db, want, speed * delta * (2.0 if i == _active else 1.0))
		if i != _active and p.volume_db <= -79.0:
			p.stop()
	# advance the playlist shortly before a combat track ends
	if _mode == "combat":
		var cur := _mus[_active]
		if cur.stream and cur.playing:
			var left := _mus_track[_active].length() - cur.get_playback_position()
			if left < FADE:
				_next_combat_track()
		elif cur.stream and not cur.playing:
			_next_combat_track()


## Combo heat raises the music's intensity; an enraged boss pins it high.
## Layers fade in fast and drop out slowly.
func _update_intensity(delta: float) -> void:
	var want := clampf(Game.combo / COMBO_FOR_FULL_INTENSITY, 0.0, 1.0)
	if _enraged:
		want = maxf(want, ENRAGED_INTENSITY)
	if _cut:
		want = 0.0
	var rate := INTENSITY_RISE if want > intensity else INTENSITY_FALL
	var was := intensity
	intensity = move_toward(intensity, want, rate * delta)
	if intensity != was:
		for t in _mus_track:
			if t:
				t.set_intensity(intensity)
