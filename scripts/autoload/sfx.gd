extends Node
## Sound playback with player pools (2D + positional), plus the music director:
## a seeded shuffle of the combat tracks with crossfades, a theme per boss and
## a title theme. Tracks are generated by tools/gen_music.py.
##
## Mix (spec §10.1): every sound goes through a bus from default_bus_layout.tres
## (Master, Music, SFX, Ambience, UI). The mix levels live on those buses; the
## Settings menu adds the player's sliders on top. Music ducking lives on the
## music players, never on a bus's volume.

const NAMES := [
	"shotgun", "recharge", "empty", "zap", "felled", "flatline", "cutin", "finish", "swing0", "swing1", "swing2", "slice",
	"gore0", "gore1", "gore2", "gore_big", "execution", "deflect", "headshot",
	"hurt", "enemy_shot", "windup", "roar", "slam", "dash", "jump", "land",
	"jumppad", "pickup", "levelup", "alarm", "wave_clear", "spawn",
	"player_death", "ui_click", "ui_hover", "ignite", "bolt_hit", "wave_blade",
	"explosion", "missile", "beep", "boss_intro", "riser", "blink", "shuriken",
	"gatling", "coin", "highscore", "type", "thunder",
	"tick", "stamp", "chime", "cash", "count", "go", "mult", "deal", "fanfare",
]
const BUS_MUSIC := &"Music"
const BUS_SFX := &"SFX"
const BUS_AMBIENCE := &"Ambience"
const BUS_UI := &"UI"
## Cues that are HUD feedback (menus, tally, combo counter) go on the UI bus.
const UI_CUES := [
	"ui_click", "ui_hover", "type", "tick", "stamp", "chime", "cash", "count", "go", "mult", "deal", "fanfare",
]
const AMBIENCE_CUES := ["thunder"]
## Big hits that briefly pull the music down so they land (spec §10.1).
const IMPACT_CUES := {"execution": -3.0, "gore_big": -3.0, "explosion": -2.5, "slam": -2.0, "boss_intro": -3.0}
const IMPACT_RECOVER_DB := 6.0 # dB per real second the music climbs back
## Rain (spec §10.3): two looping layers, far back and ducked under the music
## by the Ambience bus. Each slowly swells and fades so it comes and goes.
const RAIN_DB := [-80.0, -2.0, -3.0] # light layer at none / light / heavy
const RAIN_HEAVY_DB := [-80.0, -80.0, -3.0] # heavy layer
const RAIN_SWELL_DB := 6.0 # how far a layer drifts below its level
const COMBAT_TRACKS := ["combat_0", "combat_1", "combat_2", "combat_3", "combat_4", "combat_5"]
const BOSS_TRACKS := {"ninja": "boss_0", "mech": "boss_1", "oni": "boss_2"}
const MUSIC_DB := -6.0
const FADE := 2.5

var streams := {}
var music := {}
var _players: Array[AudioStreamPlayer] = []
var _players3d: Array[AudioStreamPlayer3D] = []
var _i2 := 0
var _i3 := 0
var _last := {}
var rain: AudioStreamPlayer
var rain_heavy: AudioStreamPlayer
var _rain_level := 0
var _swell := [0.0, 0.0] # current dB below the level, per rain layer
var _swell_target := [0.0, 0.0]
var _swell_t := [0.0, 0.0]
var _impact := 0.0 # dB the music is pulled down after a big hit
var _clock := 0.0 # real seconds since start (throttling; never the wall clock)
## Presentation-only randomness (pitch, rain swells): its own stream so it can
## never shift a seeded run.
var _rng := RandomNumberGenerator.new()

var _mus: Array[AudioStreamPlayer] = []
var _active := 0
var _mode := "none" # none | title | combat | boss
var _playlist: Array = []
var _pl_i := 0
var _duck := 0.0
var _fading := false
var _cut := false # music cut to silence (boss felled, player death)


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for n in NAMES:
		streams[n] = load("res://assets/audio/%s.wav" % n)
	for n in COMBAT_TRACKS + BOSS_TRACKS.values() + ["title"]:
		var st: AudioStreamOggVorbis = load("res://assets/music/%s.ogg" % n)
		st.loop = not n.begins_with("combat")
		music[n] = st
	for i in 20:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	for i in 20:
		var p3 := AudioStreamPlayer3D.new()
		p3.unit_size = 9.0
		p3.max_distance = 70.0
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		add_child(p3)
		_players3d.append(p3)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.volume_db = -80.0
		m.bus = BUS_MUSIC
		add_child(m)
		_mus.append(m)
	rain = _make_bed("res://assets/audio/rain.ogg")
	rain_heavy = _make_bed("res://assets/audio/rain_heavy.ogg")
	_rng.randomize()
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--record-mix"):
			add_child(preload("res://scripts/debug_mix_record.gd").new())


func _make_bed(path: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	var st: AudioStreamOggVorbis = load(path)
	st.loop = true
	p.stream = st
	p.volume_db = -80.0
	p.bus = BUS_AMBIENCE
	add_child(p)
	return p


func bus_for(name: String) -> StringName:
	if name in UI_CUES:
		return BUS_UI
	if name in AMBIENCE_CUES:
		return BUS_AMBIENCE
	return BUS_SFX


func _throttled(name: String, ms: int) -> bool:
	var now := _clock * 1000.0
	if _last.get(name, -100000.0) > now - ms:
		return true
	_last[name] = now
	return false


func _on_played(name: String) -> void:
	if IMPACT_CUES.has(name):
		_impact = minf(_impact, IMPACT_CUES[name])


func play(name: String, vol_db := 0.0, pitch := 1.0, pitch_var := 0.06) -> void:
	if not streams.has(name) or _throttled(name, 30):
		return
	var p := _players[_i2]
	_i2 = (_i2 + 1) % _players.size()
	p.stream = streams[name]
	p.bus = bus_for(name)
	p.volume_db = vol_db
	p.pitch_scale = pitch * _rng.randf_range(1.0 - pitch_var, 1.0 + pitch_var)
	p.play()
	_on_played(name)


func play_at(name: String, pos: Vector3, vol_db := 0.0, pitch := 1.0, pitch_var := 0.08) -> void:
	if not streams.has(name) or _throttled(name + "3d", 45):
		return
	var p := _players3d[_i3]
	_i3 = (_i3 + 1) % _players3d.size()
	p.stream = streams[name]
	p.global_position = pos
	p.bus = bus_for(name)
	p.volume_db = vol_db
	p.pitch_scale = pitch * _rng.randf_range(1.0 - pitch_var, 1.0 + pitch_var)
	p.play()
	_on_played(name)


# ---------------------------------------------------------------- weather
## 0 = dry, 1 = light rain, 2 = heavy rain (adds the heavy layer).
func set_rain(level: int) -> void:
	_rain_level = clampi(level, 0, 2)
	if RAIN_DB[_rain_level] > -79.0 and not rain.playing:
		rain.play(_rng.randf() * rain.stream.get_length())
	if RAIN_HEAVY_DB[_rain_level] > -79.0 and not rain_heavy.playing:
		rain_heavy.play(_rng.randf() * rain_heavy.stream.get_length())


func _update_bed(p: AudioStreamPlayer, layer: int, level_db: float, dt: float) -> void:
	# drift towards a new swell depth every few seconds so the rain ebbs
	_swell_t[layer] -= dt
	if _swell_t[layer] <= 0.0:
		_swell_t[layer] = _rng.randf_range(5.0, 12.0)
		_swell_target[layer] = -_rng.randf() * RAIN_SWELL_DB
	_swell[layer] = move_toward(_swell[layer], _swell_target[layer], 1.2 * dt)
	var want: float = level_db + _swell[layer] if level_db > -79.0 else -80.0
	p.volume_db = move_toward(p.volume_db, want, 20.0 * dt)
	if want <= -79.0 and p.volume_db <= -79.0 and p.playing:
		p.stop()


# ---------------------------------------------------------------- music
func _crossfade_to(track: String, from_start := true) -> void:
	_cut = false
	var next := 1 - _active
	var p := _mus[next]
	p.stream = music[track]
	p.volume_db = -40.0
	p.play(0.0 if from_start else 0.0)
	_active = next
	_fading = true


func play_title_music() -> void:
	if _mode == "title":
		return
	_mode = "title"
	_crossfade_to("title")


## Starts the combat playlist in an order taken from the run seed.
func start_combat_music(seed_v: int) -> void:
	var r := RandomNumberGenerator.new()
	r.seed = seed_v
	_playlist = COMBAT_TRACKS.duplicate()
	for i in range(_playlist.size() - 1, 0, -1):
		var j := r.randi_range(0, i)
		var tmp = _playlist[i]
		_playlist[i] = _playlist[j]
		_playlist[j] = tmp
	_pl_i = 0
	_mode = "combat"
	_crossfade_to(_playlist[0])


func _next_combat_track() -> void:
	_pl_i = (_pl_i + 1) % _playlist.size()
	_crossfade_to(_playlist[_pl_i])


func play_boss_music(kind: String) -> void:
	_mode = "boss"
	_crossfade_to(BOSS_TRACKS.get(kind, "boss_0"))


func end_boss_music() -> void:
	if _mode != "boss":
		return
	_mode = "combat"
	_next_combat_track()


## Cuts the music to silence fast (the hush after a boss dies, or you do).
func music_cut() -> void:
	_cut = true
	_mode = "none"


## Brings the combat playlist back after a cut, on the next track.
func resume_combat() -> void:
	_mode = "combat"
	_next_combat_track()


func duck_music(db: float) -> void:
	# kept for callers: 0 = full, negative = quieter
	_duck = clampf(db - MUSIC_DB, -60.0, 0.0)


func _process(_delta: float) -> void:
	# presentation runs on real time, so slow-mo and hitstop never drag a fade
	var delta := Game.real_dt
	_clock += delta
	_update_bed(rain, 0, RAIN_DB[_rain_level], delta)
	_update_bed(rain_heavy, 1, RAIN_HEAVY_DB[_rain_level], delta)
	_impact = move_toward(_impact, 0.0, IMPACT_RECOVER_DB * delta)
	var target := MUSIC_DB + _duck + _impact
	for i in _mus.size():
		var p := _mus[i]
		if not p.playing:
			continue
		var want := target if (i == _active and not _cut) else -80.0
		var speed := 40.0 / FADE if not _cut else 90.0
		p.volume_db = move_toward(p.volume_db, want, speed * delta * (2.0 if i == _active else 1.0))
		if i != _active and p.volume_db <= -79.0:
			p.stop()
	# advance the playlist shortly before a combat track ends
	if _mode == "combat":
		var cur := _mus[_active]
		if cur.stream and cur.playing:
			var left := cur.stream.get_length() - cur.get_playback_position()
			if left < FADE:
				_next_combat_track()
		elif cur.stream and not cur.playing:
			_next_combat_track()
